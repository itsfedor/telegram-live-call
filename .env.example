# Copy to .env; supply your own values. These are not bot credentials.
# Telegram API credentials: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# User IDs: your owner account and a SEPARATE assistant user account.
CALL_OWNER_ID=
CALL_SOURCE_ID=
# Optional cache-miss resolver; resolved ID must still equal CALL_OWNER_ID.
# CALL_OWNER_USERNAME=
# Leave unset to use the per-user default state/session location.
# SESSION_PATH=
# STATE_DIR=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENROUTER_API_KEY=
CHAT_MODEL=openai/gpt-4.1-mini
TTS_MODEL=eleven_v4
# Total seconds, INCLUDING ringing; range 1..300. Start with 60.
CALL_MAX_SECONDS=60
# Optional greeting text, rendered once and cached by text/voice/model.
# CALL_GREETING=
# Optional local plain-text prompt. Its contents go to your model provider.
# CONTEXT_FILE=
